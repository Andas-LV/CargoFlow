# Скопируй в .env и заполни. Ключи совпадают с .env; значения ниже — плейсхолдеры.
# Для локального запуска с deploy/docker-compose.yml подходят значения из комментариев «локально:».

# ---------- общее ----------
# local | staging | production
APP_ENV=local
# debug | info | warn | error
LOG_LEVEL=info
# true — сервис сам накатывает встроенные миграции goose при старте (нужно на Render)
MIGRATE_ON_START=false

# ---------- адреса сервисов ----------
# Адрес, который слушает gateway
GATEWAY_HTTP_ADDR=:8080
# host:port gRPC-сервисов. Gateway по ним подключается, сам сервис слушает тот же порт на всех интерфейсах.
# локально: localhost:50051 / 50052 / 50053; на Render: <service-host>:<port> из private network
AUTH_GRPC_ADDR=
SHIPMENT_GRPC_ADDR=
TRACKING_GRPC_ADDR=
# Адреса HTTP-серверов /healthz и /readyz (локально: :8081 / :8082 / :8083 / :8085)
AUTH_HTTP_ADDR=:8081
SHIPMENT_HTTP_ADDR=:8082
TRACKING_HTTP_ADDR=:8083
NOTIFICATION_HTTP_ADDR=:8085
# Список origin через запятую: Vite-фронт локально + домен на Vercel
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<your-app>.vercel.app

# ---------- gateway: rate limit (fixed window в Redis, на IP) ----------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ---------- Postgres (Neon на проде, отдельная БД на сервис) ----------
# локально: postgres://cargo:cargo@localhost:5434/auth?sslmode=disable
# Neon:     postgres://<user>:<password>@<endpoint>.neon.tech/auth?sslmode=require
AUTH_DATABASE_URL=
SHIPMENT_DATABASE_URL=
TRACKING_DATABASE_URL=

# ---------- shipment ----------
# Как часто outbox-воркер забирает неотправленные события
OUTBOX_POLL_INTERVAL=1s
# TTL кеша заявок в Redis
SHIPMENT_CACHE_TTL=5m

# ---------- Redis (Upstash / Render Key Value на проде) ----------
# локально: redis://localhost:6379/0; Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=

# ---------- NATS (Synadia Cloud на проде) ----------
# локально: nats://localhost:4222; Synadia: tls://connect.ngs.global
NATS_URL=
# Путь к .creds-файлу Synadia (на Render — Secret File, например /etc/secrets/nats.creds)
NATS_CREDS_FILE=

# ---------- JWT ----------
# Длинные случайные строки, например: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ---------- OpenTelemetry (Jaeger локально, Grafana Cloud на проде) ----------
# host:port OTLP/gRPC-коллектора. Пусто — трейсинг выключен.
# локально: localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
# Заголовки через запятую: key1=value1,key2=value2 (например Authorization=Basic <base64>)
OTEL_EXPORTER_OTLP_HEADERS=
# true — без TLS (локальный Jaeger)
OTEL_EXPORTER_OTLP_INSECURE=false

# ---------- уведомления (Telegram) ----------
# Пусто — уведомления не отправляются, сервис работает дальше.
# Токен: @BotFather → /newbot. Chat ID: напиши боту, затем открой
# https://api.telegram.org/bot<токен>/getUpdates и возьми result[].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
