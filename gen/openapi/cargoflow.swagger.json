{
  "swagger": "2.0",
  "info": {
    "title": "CargoFlow API",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "AuthService",
      "description": "AuthService issues and validates JWT tokens."
    },
    {
      "name": "NotificationService",
      "description": "NotificationService manages where a user receives notifications.\nAll methods act on the authenticated user (`x-user-id` metadata set by the gateway)."
    },
    {
      "name": "StationService",
      "description": "StationService is the directory of Kazakhstan railway stations and halts.\nData: © OpenStreetMap contributors (ODbL)."
    },
    {
      "name": "ShipmentService",
      "description": "ShipmentService manages transportation requests (shipments).\nAll methods require an authenticated user; the gateway passes it as `x-user-id` metadata."
    },
    {
      "name": "TrackingService",
      "description": "TrackingService stores movement events and exposes the route history of a shipment."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/v1/auth/login": {
      "post": {
        "summary": "Login exchanges credentials for an access/refresh token pair.",
        "operationId": "AuthService_Login",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/LoginRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ],
        "security": []
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "summary": "Refresh rotates a refresh token and returns a new token pair.",
        "operationId": "AuthService_Refresh",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/RefreshResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RefreshRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ],
        "security": []
      }
    },
    "/v1/auth/register": {
      "post": {
        "summary": "Register creates a new user account.",
        "operationId": "AuthService_Register",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/RegisterResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RegisterRequest"
            }
          }
        ],
        "tags": [
          "AuthService"
        ],
        "security": []
      }
    },
    "/v1/notifications/telegram": {
      "get": {
        "summary": "GetTelegramStatus tells whether the user's Telegram is connected.",
        "operationId": "NotificationService_GetTelegramStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GetTelegramStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "tags": [
          "NotificationService"
        ]
      },
      "delete": {
        "summary": "UnlinkTelegram stops Telegram notifications for the user.",
        "operationId": "NotificationService_UnlinkTelegram",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/UnlinkTelegramResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "tags": [
          "NotificationService"
        ]
      }
    },
    "/v1/notifications/telegram/link": {
      "post": {
        "summary": "CreateTelegramLink returns a one-time t.me deep link. Opening it and pressing \"Start\"\nconnects the user's Telegram chat to their CargoFlow account.",
        "operationId": "NotificationService_CreateTelegramLink",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/CreateTelegramLinkResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateTelegramLinkRequest"
            }
          }
        ],
        "tags": [
          "NotificationService"
        ]
      }
    },
    "/v1/shipments": {
      "get": {
        "summary": "ListShipments returns the caller's shipments, newest first.",
        "operationId": "ShipmentService_ListShipments",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/ListShipmentsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "pageSize",
            "description": "Max items to return, 1..100. Defaults to 20.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "ShipmentService"
        ]
      },
      "post": {
        "operationId": "ShipmentService_CreateShipment",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/CreateShipmentResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateShipmentRequest"
            }
          }
        ],
        "tags": [
          "ShipmentService"
        ]
      }
    },
    "/v1/shipments/{id}": {
      "get": {
        "operationId": "ShipmentService_GetShipment",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GetShipmentResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "ShipmentService"
        ]
      }
    },
    "/v1/shipments/{id}/status": {
      "patch": {
        "operationId": "ShipmentService_UpdateShipmentStatus",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/UpdateShipmentStatusResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateShipmentStatusBody"
            }
          }
        ],
        "tags": [
          "ShipmentService"
        ]
      }
    },
    "/v1/shipments/{shipmentId}/positions": {
      "post": {
        "summary": "AddPosition records that a shipment passed a station.",
        "operationId": "TrackingService_AddPosition",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/AddPositionResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "shipmentId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/AddPositionBody"
            }
          }
        ],
        "tags": [
          "TrackingService"
        ]
      }
    },
    "/v1/shipments/{shipmentId}/route": {
      "get": {
        "summary": "GetRoute returns all recorded positions of a shipment in chronological order.",
        "operationId": "TrackingService_GetRoute",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GetRouteResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "shipmentId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "TrackingService"
        ]
      }
    },
    "/v1/stations": {
      "get": {
        "summary": "SearchStations finds stations by name (Russian, Kazakh, English) or ESR code, for autocomplete.",
        "operationId": "StationService_SearchStations",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/SearchStationsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "query",
            "description": "Part of a name or an ESR code, e.g. \"жезк\", \"Almaty\", \"677008\".",
            "in": "query",
            "required": true,
            "type": "string"
          },
          {
            "name": "pageSize",
            "description": "Max items to return, 1..50. Defaults to 20.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "StationService"
        ]
      }
    },
    "/v1/stations/{id}": {
      "get": {
        "operationId": "StationService_GetStation",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/GetStationResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/Status"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "StationService"
        ]
      }
    }
  },
  "definitions": {
    "AddPositionBody": {
      "type": "object",
      "properties": {
        "stationId": {
          "type": "string"
        }
      },
      "required": [
        "stationId"
      ]
    },
    "AddPositionResponse": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/definitions/Position"
        }
      }
    },
    "Any": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "CargoType": {
      "type": "string",
      "enum": [
        "CARGO_TYPE_UNSPECIFIED",
        "CARGO_TYPE_WAGON",
        "CARGO_TYPE_CONTAINER"
      ],
      "default": "CARGO_TYPE_UNSPECIFIED"
    },
    "CreateShipmentRequest": {
      "type": "object",
      "properties": {
        "cargoType": {
          "$ref": "#/definitions/CargoType"
        },
        "originStationId": {
          "type": "string",
          "description": "Station IDs from StationService, e.g. \"osm-n260543817\"."
        },
        "destinationStationId": {
          "type": "string"
        }
      },
      "required": [
        "cargoType",
        "originStationId",
        "destinationStationId"
      ]
    },
    "CreateShipmentResponse": {
      "type": "object",
      "properties": {
        "shipment": {
          "$ref": "#/definitions/Shipment"
        }
      }
    },
    "CreateTelegramLinkRequest": {
      "type": "object"
    },
    "CreateTelegramLinkResponse": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "title": "e.g. https://t.me/cargoflow_bot?start=K7x9QpLm2aBc"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "GetRouteResponse": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Position"
          }
        }
      }
    },
    "GetShipmentResponse": {
      "type": "object",
      "properties": {
        "shipment": {
          "$ref": "#/definitions/Shipment"
        }
      }
    },
    "GetStationResponse": {
      "type": "object",
      "properties": {
        "station": {
          "$ref": "#/definitions/Station"
        }
      }
    },
    "GetTelegramStatusResponse": {
      "type": "object",
      "properties": {
        "linked": {
          "type": "boolean"
        },
        "linkedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Set only when linked."
        }
      }
    },
    "ListShipmentsResponse": {
      "type": "object",
      "properties": {
        "shipments": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Shipment"
          }
        }
      }
    },
    "LoginRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "password"
      ]
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "tokens": {
          "$ref": "#/definitions/TokenPair"
        }
      }
    },
    "Position": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "shipmentId": {
          "type": "string"
        },
        "station": {
          "type": "string",
          "description": "Station name (Russian) at the time of recording."
        },
        "lat": {
          "type": "number",
          "format": "double"
        },
        "lon": {
          "type": "number",
          "format": "double"
        },
        "source": {
          "type": "string",
          "description": "What produced this position: \"manual\" or an event subject such as \"shipment.created\"."
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stationId": {
          "type": "string",
          "description": "Station ID from the station directory (shipment.v1.StationService)."
        }
      }
    },
    "RefreshRequest": {
      "type": "object",
      "properties": {
        "refreshToken": {
          "type": "string"
        }
      },
      "required": [
        "refreshToken"
      ]
    },
    "RefreshResponse": {
      "type": "object",
      "properties": {
        "tokens": {
          "$ref": "#/definitions/TokenPair"
        }
      }
    },
    "RegisterRequest": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string",
          "description": "At least 8 characters."
        }
      },
      "required": [
        "email",
        "password"
      ]
    },
    "RegisterResponse": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "SearchStationsResponse": {
      "type": "object",
      "properties": {
        "stations": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Station"
          }
        }
      }
    },
    "Shipment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "cargoType": {
          "$ref": "#/definitions/CargoType"
        },
        "status": {
          "$ref": "#/definitions/ShipmentStatus"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "originStation": {
          "$ref": "#/definitions/Station"
        },
        "destinationStation": {
          "$ref": "#/definitions/Station"
        }
      }
    },
    "ShipmentStatus": {
      "type": "string",
      "enum": [
        "SHIPMENT_STATUS_UNSPECIFIED",
        "SHIPMENT_STATUS_CREATED",
        "SHIPMENT_STATUS_IN_TRANSIT",
        "SHIPMENT_STATUS_DELIVERED",
        "SHIPMENT_STATUS_CANCELLED"
      ],
      "default": "SHIPMENT_STATUS_UNSPECIFIED"
    },
    "Station": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable directory ID, e.g. \"osm-n922818608\"."
        },
        "esr": {
          "type": "string",
          "description": "6-digit ESR code; empty when unknown."
        },
        "kind": {
          "$ref": "#/definitions/StationKind"
        },
        "name": {
          "type": "string",
          "description": "Name as signed locally (Kazakh or Russian)."
        },
        "nameRu": {
          "type": "string"
        },
        "nameKk": {
          "type": "string",
          "description": "Empty when there is no Kazakh name."
        },
        "nameEn": {
          "type": "string",
          "description": "Empty when there is no English name."
        },
        "lat": {
          "type": "number",
          "format": "double"
        },
        "lon": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "StationKind": {
      "type": "string",
      "enum": [
        "STATION_KIND_UNSPECIFIED",
        "STATION_KIND_STATION",
        "STATION_KIND_HALT"
      ],
      "default": "STATION_KIND_UNSPECIFIED",
      "description": " - STATION_KIND_STATION: A station: cargo operations are possible.\n - STATION_KIND_HALT: A halt (остановочный пункт): a stop without a station building."
    },
    "Status": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/Any"
          }
        }
      }
    },
    "TokenPair": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string"
        },
        "refreshToken": {
          "type": "string"
        },
        "expiresIn": {
          "type": "string",
          "format": "int64",
          "description": "Access token lifetime in seconds."
        }
      }
    },
    "UnlinkTelegramResponse": {
      "type": "object"
    },
    "UpdateShipmentStatusBody": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/definitions/ShipmentStatus"
        }
      },
      "required": [
        "status"
      ]
    },
    "UpdateShipmentStatusResponse": {
      "type": "object",
      "properties": {
        "shipment": {
          "$ref": "#/definitions/Shipment"
        }
      }
    }
  },
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "description": "Access token: `Bearer \u003caccess_token\u003e`",
      "name": "Authorization",
      "in": "header"
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ]
}
